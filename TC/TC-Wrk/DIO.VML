%CELL ('TRST')
	%LIBRARY_NAME = 'dio';
	%LIBRARY_ALIAS = 'DIO';
	%INPUT_PINS = 'A' 'E';
	%TRISTATE_PINS = 'Q';
	%EBC
		%TRISTATE
			%BUS_WIDTH = 1,
			%INPUT = 'A',
			%ENABLE_IN = 'E',
			%Z = 'Q';
	%END_EBC
	%RESOURCES
		%AREA = 1;
		%INPINS ( 'A' 'E' )
			%PIN_LOAD = 0;
			%PIN_CAPACITANCE = 0;
		%END_INPINS
		%TRIPINS ( 'Q' )
			%PIN_LOAD = 0;
			%PIN_CAPACITANCE = 0;
			%MAX_LOAD = 0;
			%DRIVE_SLOPE = 0 0;
			%SOURCE_PINS ( 'A' )
				%PROP_DELAY %RISE = 0, %FALL = 0;
				%PHASE = N;
			%END_SOURCE_PINS
			%ENABLE_PINS ( 'E' )
				%PROP_DELAY = 0 0 0 0;
				%PHASE = R;
			%END_ENABLE_PINS
		%END_TRIPINS
	%END_RESOURCES
%END_CELL
