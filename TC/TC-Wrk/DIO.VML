%CELL ('RSLATCH')
	%LIBRARY_NAME = 'dio';
	%LIBRARY_ALIAS = 'DIO';
	%INPUT_PINS = 'R' 'S';
	%OUTPUT_PINS = 'Q' 'QN';
	%EBC
		%RSLATCH
			%R = 'R',
			%S = 'S',
			%RSCLASH = HH,
			%Q = 'Q',
			%QN = 'QN';
	%END_EBC
	%RESOURCES
		%AREA = 10;
		%INPINS ( 'R' 'S' )
			%PIN_LOAD = 0;
			%PIN_CAPACITANCE = 0;
		%END_INPINS
		%OUTPINS ( 'Q' )
			%MAX_LOAD = 0;
			%DRIVE_SLOPE = 0 0;
			%SOURCE_PINS ( 'R' 'S' )
				%PROP_DELAY %RISE = 0, %FALL = 0;
				%PHASE = U;
			%END_SOURCE_PINS
		%END_OUTPINS
		%OUTPINS ( 'QN' )
